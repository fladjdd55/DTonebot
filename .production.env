# ==============================================
# 🌍 SERVER CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=5000

# Comma-separated list of domains allowed to call your API.
# In DEV: use localhost. In PROD: use your domain (e.g., https://taptopload.com).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5000

# The URL of your backend API (used by the frontend)
VITE_API_URL=http://localhost:5000/api


# ==============================================
# 🔐 AUTHENTICATION & DATABASE
# ==============================================
# Generate a random string for JWT (run `openssl rand -hex 32` in terminal)
JWT_SECRET=put_a_long_random_secure_string_here
JWT_EXPIRES_IN=7d

# Connection string for PostgreSQL (Supabase, Neon, or Local)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:pass@localhost:5432/dtonebot

# Redis for Rate Limiting & Caching (Optional in Dev, Required for Production performance)
# If using localhost: redis://localhost:6379
REDIS_URL=redis://localhost:6379


# ==============================================
# 📱 DTONE (PROVIDER) CONFIGURATION
# ==============================================
# Get these from DTOne Developer Dashboard
DTONE_API_KEY=your_dtone_api_key
DTONE_API_SECRET=your_dtone_api_secret
DTONE_MODE=sandbox
# Use 'production' when you go live

# 🛡️ DTONE SECURITY (CRITICAL - From our recent fix)
# You MUST set these in your DTOne Dashboard settings under "Callback"
DTONE_WEBHOOK_USER=my_webhook_user
DTONE_WEBHOOK_PASS=my_secure_webhook_password

# Whitelist IPs: Comma-separated list of DTOne IP addresses.
# If testing locally, leave blank or add your IP.
DTONE_WHITELIST_IPS=

# The URL where DTOne sends updates.
# DEV: Use Ngrok (e.g., https://your-ngrok.io)
# PROD: Your actual domain (e.g., https://api.taptopload.com)
DTONE_CALLBACK_URL=http://localhost:5000


# ==============================================
# 💰 PRICING & MARGINS
# ==============================================
# Minimum order amount in USD to prevent losing money on small fees
VITE_MIN_USD_ORDER=5

# Margin multiplier (1.15 = 15% profit on top of wholesale cost)
DTONE_FALLBACK_MARGIN=1.15
VITE_DTONE_FALLBACK_MARGIN=1.15

# Enable users to type their own amount for "Ranged" products?
VITE_ENABLE_CUSTOM_AMOUNT=true

# Sync products from DTOne on server start? (Set false to speed up dev restart)
SYNC_ON_STARTUP=true


# ==============================================
# 💳 STRIPE PAYMENTS
# ==============================================
# Public Key (Starts with pk_test_...) - Used by React Frontend
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret Key (Starts with sk_test_...) - Used by Node Server
STRIPE_SECRET_KEY=sk_test_...

# Webhook Secret (Starts with whsec_...) - Used to verify payments
# You get this by running `stripe listen` in CLI or from Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...


# ==============================================
# 🤖 EMAIL & PASSWORD RESET
# ==============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_SECURE=false
FROM_EMAIL=noreply@rechargebot.com

# Frontend URL (for email links)
FRONTEND_URL=https://dev.taptopload.com

# Logging
LOG_LEVEL=info

# Two-Factor Auth
TWO_FACTOR_ISSUER=flad
ADMIN_EMAILS=jd@taptopload.com


# ==============================================
# 🤖 EXTRAS (Optional)
# ==============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_APP_URL=
ADMIN_WEBHOOK_URL=
REFRESH_TOKEN_ENCRYPTION_KEY=

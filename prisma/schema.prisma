generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ✅ FIXED: Enforcing statuses at the DB level
enum TransactionStatus {
  INITIALIZED
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  REFUND_FAILED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  phone        String?
  deletedAt    DateTime? 
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  transactions  Transaction[]
  refreshTokens RefreshToken[]
  
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Transaction {
  id              Int               @id @default(autoincrement())
  externalId      String            @unique
  paymentIntentId String            @unique 
  mobile          String
  email           String?           // ✅ FIXED: Added for guest purchase linking
  productId       Int
  amount          Float
  currency        String
  productType     String?
  status          TransactionStatus @default(PENDING) // ✅ FIXED: Uses Enum
  processedVia    String?           
  
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([paymentIntentId])
  @@index([externalId])
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("transactions")
}

model Product {
  id            Int      @id
  name          String
  type          String
  serviceId     Int
  subserviceId  Int?
  operatorId    Int
  currency      String
  amount        Float?
  minAmount     Float?
  maxAmount     Float?
  costPrice     Float?
  costPriceMin  Float?
  costPriceMax  Float?
  costCurrency  String?  @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([operatorId])
  @@index([currency])
  @@index([type])
  @@index([operatorId, currency])
  @@index([serviceId, subserviceId])
  @@map("products")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([expiresAt])
  @@index([revoked])
  @@map("refresh_tokens")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  processed   Boolean  @default(false)
  processedAt DateTime?
  payload     Json?
  createdAt   DateTime @default(now())
  
  @@index([eventId])
  @@index([processed, createdAt])
  @@map("webhook_events")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  
  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

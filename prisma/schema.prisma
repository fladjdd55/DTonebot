// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id              String   @id @default(uuid())
  externalId      String   @unique
  paymentIntentId String?
  mobile          String
  productId       Int
  productType     String    
  amount          Float
  status          String
  currency        String
  paymentId       String    @unique 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ✅ NEW: Product Catalog for Caching
model Product {
  id            Int      @id 
  name          String
  description   String?
  type          String   
  serviceId     Int
  operatorId    Int
  
  // Pricing & Value
  amount        Float?   
  currency      String
  minAmount     Float?   
  maxAmount     Float?   
  
  updatedAt     DateTime @updatedAt

  @@index([operatorId]) 
}

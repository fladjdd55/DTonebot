generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // ✅ This is required in Prisma 5
}

model Transaction {
  id              String   @id @default(uuid())
  externalId      String   @unique
  paymentIntentId String?
  mobile          String
  productId       Int
  productType String    // e.g., FIXED_VALUE_RECHARGE, RANGED_VALUE_RECHARGE
  amount          Float
  status          String
  currency        String
  paymentId   String    @unique // Stripe Payment Intent ID for refunds/tracking
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

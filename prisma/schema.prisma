generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id              String   @id @default(uuid())
  externalId      String   @unique
  
  // ✅ FIX: This MUST be @unique to act as a "lock" against race conditions.
  // If a second request tries to use the same Stripe ID, the DB will reject it.
  paymentIntentId String?  @unique
  
  mobile          String
  productId       Int
  productType     String    
  amount          Float
  status          String
  currency        String
  
  // Optional: You can keep this for legacy references, but paymentIntentId is the main key
  paymentId       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Product {
  id            Int      @id 
  name          String
  description   String?
  type          String   
  serviceId     Int
  operatorId    Int
  
  // Pricing & Value
  amount        Float?
  currency      String
  minAmount     Float?   
  maxAmount     Float?
  updatedAt     DateTime @updatedAt

  @@index([operatorId]) 
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id              String   @id @default(uuid())
  externalId      String   @unique
  paymentIntentId String?  @unique
  paymentId       String?    
  
  mobile          String
  productId       Int
  productType     String    
  amount          Float
  currency        String
  status          String
  processedVia    String?  // "API" or "WEBHOOK" - tracks who handled it

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Product {
  id            Int      @id 
  name          String
  description   String?
  type          String   
  serviceId     Int
  operatorId    Int
  
  // Pricing & Value
  amount        Float?
  currency      String
  minAmount     Float?   
  maxAmount     Float?
  updatedAt     DateTime @updatedAt

  @@index([operatorId]) 
}

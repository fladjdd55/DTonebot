generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionStatus {
  INITIALIZED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  REFUND_FAILED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  phone        String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // ✅ CORRECT LOCATION: Auth fields belong here
  emailVerified        Boolean   @default(false)
  verifyToken          String?   @unique
  verifyExpires        DateTime?
  
  resetToken           String?   @unique
  resetExpires         DateTime?

  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?   
  twoFactorTempSecret  String?   
  twoFactorBackupCodes String[]  @default([])

  transactions  Transaction[]
  refreshTokens RefreshToken[]
  
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Transaction {
  id              Int               @id @default(autoincrement())
  externalId      String            @unique
  paymentIntentId String            @unique 
  mobile          String
  email           String?
  
  productId       Int
  product         Product           @relation(fields: [productId], references: [id])

  amount          Float
  currency        String
  productType     String?
  status          TransactionStatus @default(PENDING)
  processedVia    String?
  dtoneTransactionId String?

  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([paymentIntentId])
  @@index([externalId])
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("transactions")
}

model Product {
  id            Int      @id
  name          String
  type          String
  serviceId     Int
  subserviceId  Int?
  operatorId    Int
  operator      Operator  @relation(fields: [operatorId], references: [id])
  currency      String
  amount        Float?
  minAmount     Float?
  maxAmount     Float?
  benefits      String[]  @default([])
  costPrice     Float?
  costPriceMin  Float?
  costPriceMax  Float?
  costCurrency  String?  @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  transactions  Transaction[]
  
  @@index([operatorId])
  @@index([currency])
  @@index([type])
  @@index([operatorId, currency])
  @@index([serviceId, subserviceId])
  @@map("products")
}

model Operator {
  id          Int       @id
  name        String
  countryId   Int
  country     Country   @relation(fields: [countryId], references: [id])
  products    Product[]
  
  @@map("operators")
}

model Country {
  id        Int        @id
  isoCode   String     
  name      String
  operators Operator[]

  @@map("countries")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([expiresAt])
  @@index([revoked])
  @@map("refresh_tokens")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  processed   Boolean  @default(false)
  processedAt DateTime?
  payload     Json?
  createdAt   DateTime @default(now())
  
  @@index([eventId])
  @@index([processed, createdAt])
  @@map("webhook_events")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  
  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

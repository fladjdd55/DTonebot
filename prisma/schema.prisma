// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================================================
// USER MODEL (Updated)
// ==================================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  transactions  Transaction[]
  refreshTokens RefreshToken[] // ✅ ADD THIS LINE (Fixes the error)
}

// ==================================================================
// TRANSACTION MODEL
// ==================================================================
model Transaction {
  id              Int      @id @default(autoincrement())
  externalId      String   @unique
  paymentIntentId String?  @unique
  paymentId       String?
  
  mobile          String
  productId       Int
  amount          Float
  currency        String
  productType     String?

  status          String   @default("PENDING")
  processedVia    String?
  
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================================================================
// PRODUCT MODEL
// ==================================================================
model Product {
  id            Int      @id
  name          String
  type          String
  serviceId     Int
  operatorId    Int
  currency      String
  
  amount        Float?
  minAmount     Float?
  maxAmount     Float?
  
  costPrice     Float?
  costPriceMin  Float?
  costPriceMax  Float?
  costCurrency  String?  @default("USD")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================================================================
// REFRESH TOKEN MODEL (New)
// ==================================================================
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}
